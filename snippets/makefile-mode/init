# key: init
# name: init
# expand-env: ((yas-indent-line 'fixed) (yas-wrap-around-region 'nil))
# --
# Each rule uses a single Bash instance.
# The Bash script uses strict mode.
# It is silent by default.
SHELL := bash
.SHELLFLAGS := -ceuo pipefail
MAKEFLAGS += --no-print-directory
.ONESHELL:
.SILENT:

# `make env' build a development environment. Within this environment, production
# and development dependencies are installed.
.PHONY: env
env:
        if [[ -v GUIX_ENVIRONMENT ]]; then
          uv install --python python3.12 --with pip aider-chat@latest
        else
          guix shell -m manifest.scm --pure -- bash -c "make env"
          guix shell -m manifest.scm --pure
        fi

# `make test' executes all tests.
.PHONY: test
test:
        if [[ -v GUIX_ENVIRONMENT ]]; then
          guix shell -m manifest.scm -- bash -c "make test"
        else
          echo "test"
        fi

# `make dist' builds an artifact that may be deployed on some target machine.
.PHONY: dist
dist:
        if [[ -v GUIX_ENVIRONMENT ]]; then
          guix shell -m manifest.scm -- bash -c "make dist"
        else
          echo "dist"
        fi

# `make clean' deletes all generated files.
.PHONY: clean
clean:
        rm -rfv _*
